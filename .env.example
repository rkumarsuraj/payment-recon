# Copy to .env and adjust as needed. Never commit the real .env.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/setu_db

# Reconciliation grace windows (hours)
UNSETTLED_AFTER_HOURS=48
STUCK_AFTER_HOURS=24

# Request limits
MAX_BATCH_SIZE=1000
MAX_PAGE_SIZE=200
DEFAULT_PAGE_SIZE=50
MAX_SUMMARY_PAGE_SIZE=500
DEFAULT_SUMMARY_PAGE_SIZE=100

FUTURE_TIMESTAMP_TOLERANCE_MINUTES=5

# Optional. Leave blank to disable API key enforcement (not currently
# wired into the routers -- present for forward compatibility; see
# README "What I'd do differently with more time").
API_KEY=

LOG_LEVEL=INFO
APP_VERSION=1.0.0
