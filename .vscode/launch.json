{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: uvicorn (debug, breakpoints work)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "env": {
        "DATABASE_URL": "postgresql+psycopg2://postgres:postgres@localhost:5432/setu_db"
      },
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "-s"],
      "env": {
        "DATABASE_URL": "postgresql+psycopg2://postgres:postgres@localhost:5432/setu_test"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: full suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "env": {
        "DATABASE_URL": "postgresql+psycopg2://postgres:postgres@localhost:5432/setu_test"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Script: load sample data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/load_sample_data.py",
      "args": ["--base-url", "http://localhost:8000", "--file", "sample_events_augmented.json", "--batch-size", "500"],
      "console": "integratedTerminal"
    }
  ]
}
